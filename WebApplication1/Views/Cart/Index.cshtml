<table class="table table-bordered">
    <thead>
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Line Total</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ProductName</td>

                <td>
                    <form asp-controller="Cart" asp-action="Update" method="post">

                        <input type="hidden"
                               name="ProductId"
                               value="@item.ProductId" />

                        <input type="number"
                               name="Quantity"
                               value="@item.Quantity"
                               min="1"
                               class="form-control mb-2" />

                        <button type="submit"
                                class="btn btn-warning btn-sm">
                            Update
                        </button>
                    </form>
                </td>

                <td>₱@item.UnitPrice.ToString("N2")</td>

                <td>₱@item.LineTotal.ToString("N2")</td>

                <td>
                    <form asp-controller="Cart" asp-action="Remove" method="post">

                        <input type="hidden"
                               name="productId"
                               value="@item.ProductId" />

                        <button type="submit"
                                class="btn btn-danger btn-sm">
                            Remove
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>